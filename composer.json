{
    "name": "yiendos/my-sites-ide-monitoring-prometheus",
    "description": "Prometheus metrics for my-sites-ide - scrapes any IDE container labelled prometheus.io/scrape, and takes remote writes from Alloy (OTLP and every container's CPU/memory) and Tempo",
    "type": "my-sites-ide-plugin",
    "license": "MIT",
    "keywords": ["my-sites-ide", "prometheus", "metrics", "monitoring", "observability"],
    "authors": [
        {
            "name": "Paul Yiend",
            "email": "yiendos@sbmatrix.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Yiendos\\MySitesIde\\Monitoring\\Prometheus\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.3"
    },
    "extra": {
        "my-sites-ide": {
            "commands": "src/Console",
            "compose": "docker-compose.yml",
            "env": ".env",
            "env-example": "env-example",
            "services": ["prometheus"],
            "storage": true
        }
    }
}
